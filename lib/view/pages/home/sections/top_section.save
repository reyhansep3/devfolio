class TopSection extends StatefulWidget {
  const TopSection({super.key});

  @override
  State<TopSection> createState() => _TopSectionState();
}

class _TopSectionState extends State<TopSection> {
  bool isHovered = false;
  Offset cursor = Offset.zero;
  bool isInsideName = false;

  @override
  Widget build(BuildContext context) {
    final height = MediaQuery.of(context).size.height;
    final width = MediaQuery.of(context).size.width;

    return Responsivelayout(
      mobile: _mobileBody(width, height),
      tablet: _tabletBody(width, height),
      desktop: _desktopBody(
        context, 
        width, 
        height, 
        isHovered,
        isInsideName,
        cursor,
        (val) => setState(() => isHovered = val), 
        (val) => setState(() => isInsideName = val),
        (offset) => setState(() => cursor = offset)
      ),
    );
  }
}


/// ================= DESKTOP =================
Widget _desktopBody(
  BuildContext context, 
  double width, 
  double height, 
  bool isHovered, 
  bool isInsideName,
  Offset cursor,
  void Function(bool) onHoverChanged,
  void Function(bool) onInsideNameChanged, 
  void Function(Offset) onCursorMove
) {
  final screenHeight = MediaQuery.of(context).size.height;
  const navbarHeight = 80.0; // masih belum fix
  return SizedBox(
    height: screenHeight - navbarHeight,
    child: Container(
      decoration: BoxDecoration(
          border: Border.all(
            color: Colors.transparent
          )
        ),
      child: MouseRegion(
        cursor: SystemMouseCursors.none, 
        onHover: (e) => onCursorMove(e.localPosition),
        onEnter: (_) => onHoverChanged(true),
        onExit: (_) => onHoverChanged(false),
        child: Stack(
          children: [
            Container(
              decoration: BoxDecoration(
                border: Border.all(
                  color: Colors.blue
                )
              ),
              height: screenHeight - navbarHeight,
              width: context.width,
              
              child: Center(
                child: Padding(
                  padding: const EdgeInsets.all(8.0),
                  child: MouseRegion(
                    onEnter: (_) => onInsideNameChanged(true),
                    onExit: (_) => onInsideNameChanged(false),
                    child: Container(
                      padding: EdgeInsets.all(context.height * 0.08),
                      decoration: BoxDecoration(
                        border: Border.all(color: Colors.white),
                      ),
                      child: Text(
                        "REYHAN SEPTRI ASTA",
                        style: AppFontStyle.veryLargeText
                            .copyWith(fontWeight: FontWeight.bold),
                      ),
                    ),
                  ),
                ),
              ),
              
            ),
            AnimatedPositioned(
              duration: const Duration(milliseconds: 60),
              curve: Curves.easeOut,
              left: cursor.dx - (isInsideName ? 60 : 4), 
              top: cursor.dy - (isInsideName ? 60 : 4),
              child: IgnorePointer(
                child: AnimatedContainer(
                  duration: const Duration(milliseconds: 300),
                  curve: Curves.easeInOut,
                  width: isInsideName ? 120 : 8,  
                  height: isInsideName ? 120 : 8,
                  decoration: BoxDecoration(
                    color: isInsideName
                    // ignore: deprecated_member_use
                    ? AppColor.yellowgreen.withOpacity(0.15)
                    : AppColor.yellowgreen,
                    border: Border.all(
                      color: AppColor.yellowgreen,
                      width: 1.5,
                    ),
                    borderRadius: BorderRadius.circular(
                      isInsideName ? 8 : 99,
                    ),
                  ),
                ),
              ),
            ),
            Positioned(
              top: 0,
              left: 0,
              child: IntrinsicWidth(
                child: Container(
                  padding: const EdgeInsets.all(10),
                  decoration: const BoxDecoration(
                    color: AppColor.white
                  ),
                ),
              ),
            ),
            Positioned(
              top: 0,
              right: 0,
              child: IntrinsicWidth(
                child: Container(
                  padding: const EdgeInsets.all(10),
                  decoration: const BoxDecoration(
                    color: AppColor.white
                  ),
                ),
              ),
            ),
            Positioned(
              bottom: 0,
              left: 0,
              child: IntrinsicWidth(
                child: Container(
                  padding: const EdgeInsets.all(10),
                  decoration: const BoxDecoration(
                    color: AppColor.white
                  ),
                ),
              ),
            ),
            Positioned(
              bottom: 0,
              right: 0,
              child: IntrinsicWidth(
                child: Container(
                  padding: const EdgeInsets.all(10),
                  decoration: const BoxDecoration(
                    color: AppColor.white
                  ),
                ),
              ),
            ),
          ],
        ),
      ),
    ),
